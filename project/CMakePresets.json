{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "public-release-linux",
      "displayName": "Public Release Linux",
      "description": "Configures the public source-review release profile without private parser source lanes.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceParentDir}/build/public-release-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SB_BUILD_PUBLIC_RELEASE_CORRECTNESS": "ON",
        "SB_BUILD_PUBLIC_STANDALONE_OUTPUT": "ON",
        "SB_BUILD_TESTS": "ON",
        "SB_BUILD_DATABASE_LIFECYCLE_TESTS": "OFF"
      }
    },
    {
      "name": "ai-mcp-release-proof-linux",
      "displayName": "AI MCP Release Proof Linux",
      "description": "Configures the public release profile with AI MCP runtime and live-native hard-fail release proof gates.",
      "inherits": "public-release-linux",
      "binaryDir": "${sourceParentDir}/build/ai-mcp-release-proof-linux",
      "cacheVariables": {
        "SB_AI_REQUIRE_MCP_RUNTIME": "ON",
        "SB_AI_REQUIRE_LIVE_NATIVE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "public-release-linux",
      "configurePreset": "public-release-linux",
      "jobs": 4
    },
    {
      "name": "ai-mcp-release-proof-linux",
      "configurePreset": "ai-mcp-release-proof-linux",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "public-release-linux",
      "configurePreset": "public-release-linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ai-mcp-release-proof-linux",
      "configurePreset": "ai-mcp-release-proof-linux",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^ai_"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
