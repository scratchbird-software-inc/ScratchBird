#!/bin/sh
# Copyright (c) 2026 ScratchBird Software Inc.
# SPDX-License-Identifier: MPL-2.0

set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

postinstall_stage=postinstall_wrapper_validation

log_postinstall_diagnostic() {
    case "$1" in
        BOOTSTRAP.OS_AUTHORITY_DENIED|BOOTSTRAP.SERVICE_STATE_INVALID|\
        BOOTSTRAP.GROUP_CREATE_FAILED|BOOTSTRAP.GROUP_INPUT_INVALID|\
        BOOTSTRAP.DIRECTORY_PERMISSION_INVALID|\
        BOOTSTRAP.INSTALL_DEFAULTS_INVALID)
            ;;
        *)
            return 0
            ;;
    esac
    if [ -x /usr/bin/logger ]; then
        /usr/bin/logger -t scratchbird-installer \
            "scratchbird-installer stage=$postinstall_stage code=$1" \
            >/dev/null 2>&1 || true
    fi
}

diagnostic() {
    printf '%s\n' "$1" >&2
    log_postinstall_diagnostic "$1"
}

fail() {
    diagnostic "$1"
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail BOOTSTRAP.OS_AUTHORITY_DENIED

target_volume=${3:-/}
[ "$target_volume" = / ] || fail BOOTSTRAP.INSTALL_DEFAULTS_INVALID

require_no_extended_acl() {
    path=$1
    chmod -N "$path" >/dev/null 2>&1 || \
        fail BOOTSTRAP.DIRECTORY_PERMISSION_INVALID
    acl_mode=$(ls -lde "$path" 2>/dev/null | awk 'NR == 1 { print $1 }')
    case "$acl_mode" in
        ''|*+*) fail BOOTSTRAP.DIRECTORY_PERMISSION_INVALID ;;
    esac
}

require_root_directory() {
    path=$1
    [ -d "$path" ] && [ ! -L "$path" ] || \
        fail BOOTSTRAP.DIRECTORY_PERMISSION_INVALID
    actual=$(stat -f '%Su:%Sg:%Lp' "$path" 2>/dev/null || true)
    [ "$actual" = root:wheel:755 ] || \
        fail BOOTSTRAP.DIRECTORY_PERMISSION_INVALID
    require_no_extended_acl "$path"
}

require_root_executable() {
    path=$1
    [ -f "$path" ] && [ ! -L "$path" ] && [ -x "$path" ] || \
        fail BOOTSTRAP.INSTALL_DEFAULTS_INVALID
    links=$(stat -f '%l' "$path" 2>/dev/null || true)
    [ "$links" = 1 ] || fail BOOTSTRAP.DIRECTORY_PERMISSION_INVALID
    actual=$(stat -f '%Su:%Sg:%Lp' "$path" 2>/dev/null || true)
    [ "$actual" = root:wheel:755 ] || \
        fail BOOTSTRAP.DIRECTORY_PERMISSION_INVALID
    require_no_extended_acl "$path"
}

require_root_directory /opt
require_root_directory /opt/ScratchBird
require_root_directory /opt/ScratchBird/libexec
helper=/opt/ScratchBird/libexec/scratchbird-macos-system-install
require_root_executable "$helper"

exec "$helper" post-install \
    --identity-mode system \
    --root / \
    --package-format pkg \
    --package-version '@SCRATCHBIRD_VERSION@' || \
    fail BOOTSTRAP.INSTALL_DEFAULTS_INVALID
