#!/bin/sh
# Copyright (c) 2026 ScratchBird Software Inc.
# SPDX-License-Identifier: MPL-2.0

set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    printf '%s\n' BOOTSTRAP.OS_AUTHORITY_DENIED >&2
    exit 1
fi

target_volume=${3:-/}
if [ "$target_volume" != / ]; then
    printf '%s\n' BOOTSTRAP.INSTALL_DEFAULTS_INVALID >&2
    exit 1
fi

helper=/opt/ScratchBird/libexec/scratchbird-macos-system-install

require_no_extended_acl() {
    acl_mode=$(/bin/ls -lde "$1" 2>/dev/null | \
        /usr/bin/awk 'NR == 1 { print $1 }')
    case "$acl_mode" in
        ''|*+*)
            printf '%s\n' BOOTSTRAP.DIRECTORY_PERMISSION_INVALID >&2
            exit 1
            ;;
    esac
}

for directory in /opt /opt/ScratchBird /opt/ScratchBird/libexec; do
    if [ ! -d "$directory" ] || [ -L "$directory" ] || \
       [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' "$directory" 2>/dev/null)" != \
         root:wheel:755 ]; then
        printf '%s\n' BOOTSTRAP.DIRECTORY_PERMISSION_INVALID >&2
        exit 1
    fi
    require_no_extended_acl "$directory"
done

if [ ! -f "$helper" ] || [ -L "$helper" ] || [ ! -x "$helper" ] || \
   [ "$(/usr/bin/stat -f '%Su:%Sg:%Lp' "$helper" 2>/dev/null)" != \
     root:wheel:755 ] || \
   [ "$(/usr/bin/stat -f '%l' "$helper" 2>/dev/null)" != 1 ]; then
    printf '%s\n' BOOTSTRAP.DIRECTORY_PERMISSION_INVALID >&2
    exit 1
fi
require_no_extended_acl "$helper"

if [ ! -x "$helper" ]; then
    printf '%s\n' BOOTSTRAP.INSTALL_DEFAULTS_INVALID >&2
    exit 1
fi

exec "$helper" post-install \
    --identity-mode system \
    --root / \
    --package-format pkg \
    --package-version '@SCRATCHBIRD_VERSION@'
