<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.scratchbird.sbsrv</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/ScratchBird/bin/SBsrv</string>
    <string>--config</string>
    <string>/Library/Application Support/ScratchBird/SBsrv.conf</string>
    <string>--foreground</string>
  </array>
  <key>UserName</key>
  <string>scratchbird</string>
  <key>GroupName</key>
  <string>scratchbird</string>
  <key>WorkingDirectory</key>
  <string>/var/lib/scratchbird</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>Disabled</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>23</integer>
  <key>StandardOutPath</key>
  <string>/var/log/scratchbird/SBsrv.out.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/scratchbird/SBsrv.err.log</string>
</dict>
</plist>
