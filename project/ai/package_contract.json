{
  "component_id": "adaptor:scratchbird-ai-mcp",
  "category": "adaptor",
  "name": "scratchbird-ai-mcp",
  "driver_family": "ai_mcp",
  "status": "beta_2",
  "release_scope": "in_scope_required",
  "release_bucket": "release_candidate",
  "wire_protocol": "sbwp_v1_1",
  "auth_authority": "engine",
  "transaction_authority": "mga_engine",
  "server_revalidation_required": true,
  "driver_local_authority": "advisory_only",
  "api_surface": [
    "mcp_tools",
    "http_bridge",
    "compile_execute_split",
    "language_resources",
    "predictive_sbsql",
    "metadata_resolution",
    "support_bundle"
  ],
  "route_requirements": [
    "sbwp_v1_1",
    "scratchbird_tls_1_3_floor",
    "engine_authentication_authority",
    "engine_authorization_authority",
    "mga_transaction_finality",
    "sys_information_metadata",
    "uuid_identity",
    "no_hidden_replay",
    "shared_sbsql_language_resource_pack",
    "server_revalidated_sblr_uuid_artifacts"
  ],
  "conformance": [
    "connect_auth",
    "prepare_execute_fetch",
    "transactions",
    "metadata",
    "type_mapping",
    "error_mapping",
    "reconnect",
    "protocol_negotiation",
    "cancellation",
    "mcp_runtime",
    "sblr_uuid_artifact",
    "language_resource_pack",
    "predictive_prompting",
    "authorized_metadata_resolution",
    "support_bundle_redaction",
    "cluster_boundary_fail_closed"
  ],
  "delegation_posture": {
    "mode": "delegates_to_python",
    "target_component": "driver:python",
    "host_runtime": "MCP Python runtime",
    "authority_boundaries": [
      "AI MCP may expose tools and shape requests",
      "SQL lowering occurs outside the engine through driver/parser paths",
      "original SQL text may be carried only as data/reference payload",
      "server revalidates authentication, authorization, SBLR, UUID, descriptor, cache, schema, policy, and transaction claims",
      "MGA transaction finality remains engine-owned"
    ],
    "lane_specific_proof": [
      "ai_mcp_manifest_gate",
      "ai_mcp_sblr_uuid_artifact_gate",
      "ai_mcp_language_resource_gate",
      "ai_mcp_release_integration_gate",
      "ai_mcp_final_zero_drift_audit"
    ]
  },
  "artifact_verification": {
    "package_type": "python_mcp_adaptor_bundle",
    "build_command": "python3 project/ai/scripts/ai_component_runner.py --repo-root project/ai --output-dir build/ai/gates/unit --mode unit",
    "install_smoke": "MCP runtime and HTTP bridge contract gates",
    "expected_outputs": [
      "package_contract.json",
      "pyproject.toml"
    ],
    "sbom": "release_gate_required",
    "signing": "release_gate_required",
    "license": "MPL-2.0"
  },
  "release_readiness": {
    "package_status": "release_candidate",
    "component_gate": "ai_mcp_final_zero_drift_audit",
    "artifact_isolation": "ai_build_artifact_isolation_gate",
    "source_tree_guard": "ai_mcp_public_cleanliness_gate",
    "promotion_evidence_required": "live_scratchbird_ai_mcp_conformance"
  },
  "best_in_class_deltas": [
    {
      "comparator": "mcp-python",
      "delta": "MCP stdio tool surface plus ScratchBird compile/execute, language-resource, metadata, and governance contracts",
      "proof": "ai_mcp_runtime_gate_or_release_required_refusal"
    },
    {
      "comparator": "database-ai-agent-bridges",
      "delta": "SBLR/UUID artifact handoff with server-side revalidation and MGA finality",
      "proof": "ai_mcp_sblr_uuid_artifact_gate"
    }
  ],
  "package_files": [
    "dependency_policy.json",
    "package_contract.json",
    "pyproject.toml",
    "README.md"
  ]
}
